/* 
Global Stylesheet for DurianVision
Variables used:
BG_PRIMARY: #1a1a2e
BG_SECONDARY: #16213e
BG_CARD: #0f3460
ACCENT: #22C55E
TEXT_PRIMARY: #e4e4e7
TEXT_SECONDARY: #a1a1aa
BORDER: #374151
*/

QWidget {
    background-color: #1a1a2e;
    color: #e4e4e7;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 12px;
}

/* Push Buttons */
QPushButton {
    background-color: #0f3460;
    color: #e4e4e7;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #16213e;
    border: 1px solid #22C55E;
}

QPushButton:pressed {
    background-color: #22C55E;
    color: #1a1a2e;
}

QPushButton:disabled {
    background-color: #16213e;
    color: #a1a1aa;
    border: 1px solid #374151;
}

/* Sliders */
QSlider::groove:horizontal {
    border: 1px solid #374151;
    height: 8px;
    background: #16213e;
    margin: 2px 0;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: #22C55E;
    border: 1px solid #22C55E;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #0f3460;
    border: 1px solid #374151;
    height: 8px;
    border-radius: 4px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #374151;
    background-color: #1a1a2e;
    border-radius: 4px;
}

QTabBar::tab {
    background: #16213e;
    border: 1px solid #374151;
    padding: 8px 16px;
    color: #a1a1aa;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #0f3460;
    color: #22C55E;
    border-bottom-color: #0f3460;
}

QTabBar::tab:hover:!selected {
    background: #1a1a2e;
    color: #e4e4e7;
}

/* Labels */
QLabel {
    background: transparent;
    color: #e4e4e7;
}

/* Table Widget */
QTableWidget {
    background-color: #16213e;
    color: #e4e4e7;
    gridline-color: #374151;
    border: 1px solid #374151;
    border-radius: 4px;
    selection-background-color: #0f3460;
    selection-color: #22C55E;
}

QHeaderView::section {
    background-color: #0f3460;
    color: #e4e4e7;
    padding: 4px;
    border: 1px solid #374151;
}

/* ComboBox */
QComboBox {
    background-color: #16213e;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e4e4e7;
}

QComboBox:hover {
    border: 1px solid #22C55E;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #16213e;
    border: 1px solid #374151;
    selection-background-color: #0f3460;
    selection-color: #22C55E;
}

/* CheckBox */
QCheckBox {
    spacing: 8px;
    color: #e4e4e7;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #374151;
    border-radius: 4px;
    background-color: #16213e;
}

QCheckBox::indicator:checked {
    background-color: #22C55E;
    border: 1px solid #22C55E;
}

QCheckBox::indicator:hover {
    border: 1px solid #22C55E;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #374151;
    border-radius: 4px;
    margin-top: 12px;
    font-weight: bold;
    color: #22C55E;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}
